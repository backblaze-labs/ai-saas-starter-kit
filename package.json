{
  "name": "ai-saas-starter-kit",
  "private": true,
  "scripts": {
    "doctor": "node scripts/doctor.mjs",
    "predev": "node scripts/doctor.mjs",
    "dev": "sh scripts/dev.sh",
    "dev:web": "pnpm --filter @ai-saas-starter-kit/web dev",
    "dev:api": "cd services/api && .venv/bin/uvicorn main:app --reload --port ${API_PORT:-8000}",
    "stripe:seed": "node scripts/sync-stripe-env.mjs",
    "stripe:listen": "stripe listen --forward-to localhost:${API_PORT:-8000}/billing/webhook",
    "build": "pnpm --filter @ai-saas-starter-kit/web build",
    "typecheck": "pnpm --filter @ai-saas-starter-kit/web typecheck",
    "lint": "pnpm --filter @ai-saas-starter-kit/web lint",
    "lint:api": "cd services/api && .venv/bin/ruff check .",
    "test:web": "pnpm --filter @ai-saas-starter-kit/web test",
    "test:api": "cd services/api && .venv/bin/python -m pytest",
    "check:structure": "cd services/api && .venv/bin/python -m pytest tests/test_structure.py -v",
    "test:e2e": "pnpm --filter @ai-saas-starter-kit/web exec playwright test"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  },
  "pnpm": {
    "overrides": {
      "@babel/core@7": ">=7.29.6 <8",
      "@hono/node-server": ">=2.0.5 <3",
      "ajv@6": ">=6.14.0 <7",
      "ajv@8": ">=8.18.0 <9",
      "body-parser@2": ">=2.3.0 <3",
      "brace-expansion@1": ">=1.1.16 <2",
      "brace-expansion@2": ">=2.1.2 <3",
      "brace-expansion@5": ">=5.0.8 <6",
      "express-rate-limit@8": ">=8.2.2 <9",
      "fast-uri@3": ">=3.1.4 <4",
      "flatted@3": ">=3.4.2 <4",
      "hono@4": ">=4.12.27 <5",
      "ip-address@10": ">=10.1.1 <11",
      "js-yaml@4": ">=4.3.0 <5",
      "lodash@4": ">=4.18.0 <5",
      "minimatch@3": ">=3.1.4 <4",
      "minimatch@9": ">=9.0.7 <10",
      "minimatch@10": ">=10.2.3 <11",
      "path-to-regexp@8": ">=8.4.0 <9",
      "picomatch@4": ">=4.0.4 <5",
      "postcss@8": ">=8.5.10 <9",
      "qs@6": ">=6.15.2 <7",
      "sharp@0": ">=0.35.0 <1",
      "shell-quote@1": ">=1.9.0 <2"
    }
  },
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  }
}
